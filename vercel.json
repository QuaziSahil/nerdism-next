{
    "headers": [
        {
            "source": "/(.*)\\.(jpg|jpeg|png|gif|webp|avif|svg|ico)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/_next/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/blog",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=1800, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/blog/:slug*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/about",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/contact",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=86400, stale-while-revalidate=604800"
                }
            ]
        }
    ]
}